# ── The Inclusive Citizen — Frontend (Next.js) ────────────────────────────────
# Multi-stage build.
#
# IMPORTANT: The Next.js app lives at the repository ROOT, not in frontend/.
# Run this Dockerfile with the repo root as the Docker build context:
#   docker build -f frontend/Dockerfile . -t inclusive-citizen-frontend
#
# NEXT_PUBLIC_ variables are baked into the Next.js bundle at BUILD TIME and
# cannot be injected as Cloud Run runtime env vars.  They must be passed as
# Docker build arguments here.  See the frontend/cloudbuild.yaml substitutions
# and the README Deployment section for the full explanation.

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:20-slim AS builder

# Build-time arguments for NEXT_PUBLIC_ variables.
# These are converted to ENV so Next.js picks them up during `next build`.
ARG NEXT_PUBLIC_GENKIT_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

ENV NEXT_PUBLIC_GENKIT_URL=$NEXT_PUBLIC_GENKIT_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY

WORKDIR /app

# Install dependencies before copying source for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Copy the full repository source (build context = repo root).
# frontend/.dockerignore trims the context to exclude node_modules, .next, etc.
COPY . .

# Build the Next.js app in standalone mode.
# next.config.mjs must have output: 'standalone' for this to produce server.js.
RUN npm run build

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM node:20-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

# Copy the self-contained standalone server (includes a minimal node_modules).
COPY --from=builder /app/.next/standalone ./

# Copy static assets (CSS, JS chunks, images) into the right place.
COPY --from=builder /app/.next/static ./.next/static

# Copy the public/ directory (favicons, demo audio, etc.).
COPY --from=builder /app/public ./public

EXPOSE 8080

# server.js is the entry point generated by Next.js standalone output.
CMD ["node", "server.js"]
